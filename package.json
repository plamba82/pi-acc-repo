{
    "name": "ai-chat-platform",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:ws": "tsx server/websocket-server.ts",
        "dev:all": "concurrently \"npm run dev\" \"npm run dev:ws\"",
        "build": "next build",
        "build:server": "tsc server/websocket-server.ts --outDir dist --target es2020 --module commonjs",
        "start": "next start",
        "start:ws": "node dist/websocket-server.js",
        "start:all": "concurrently \"npm start\" \"npm start:ws\"",
        "lint": "next lint",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.0.4",
        "@radix-ui/react-scroll-area": "^1.0.5",
        "@radix-ui/react-slot": "^1.0.2",
        "@tailwindcss/typography": "^0.5.0",
        "@tanstack/react-query": "^5.28.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@upstash/redis": "^1.28.0",
        "ai": "^3.0.0",
        "autoprefixer": "^10.4.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "framer-motion": "^11.0.0",
        "lucide-react": "^0.363.0",
        "nanoid": "^5.0.0",
        "next": "^14.2.0",
        "openai": "^4.28.0",
        "postcss": "^8.4.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "socket.io": "^4.7.0",
        "socket.io-client": "^4.7.0",
        "tailwind-merge": "^2.2.0",
        "tailwindcss": "^3.4.0",
        "zod": "^3.22.0",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@typescript-eslint/eslint-plugin": "^7.5.0",
        "@typescript-eslint/parser": "^7.5.0",
        "concurrently": "^8.2.2",
        "dotenv": "^16.6.1",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}